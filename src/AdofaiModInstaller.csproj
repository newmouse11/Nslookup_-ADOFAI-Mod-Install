<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>ADOFAI-Mod-Installer</AssemblyName>
    <RootNamespace>AdofaiModInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0.0</Version>
    <Product>ADOFAI Mod Installer</Product>
    <Copyright>Copyright (c) 2026 newmouse11</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json" />
  </ItemGroup>
</Project>
