<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 색상 토큰: BINANCE-STYLE.md §2.1 그대로. 이 파일 밖에서 hex 사용 금지 -->
  <SolidColorBrush x:Key="BgBase" Color="#0B0E11"/>
  <SolidColorBrush x:Key="BgSurface" Color="#181A20"/>
  <SolidColorBrush x:Key="BgCard" Color="#1E2329"/>
  <SolidColorBrush x:Key="BgElevated" Color="#2B3139"/>
  <SolidColorBrush x:Key="Border" Color="#2B3139"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#363B44"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#EAECEF"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#B7BDC6"/>
  <SolidColorBrush x:Key="TextTertiary" Color="#848E9C"/>
  <SolidColorBrush x:Key="TextDisabled" Color="#5E6673"/>
  <SolidColorBrush x:Key="Primary" Color="#FCD535"/>
  <SolidColorBrush x:Key="PrimaryHover" Color="#F0B90B"/>
  <SolidColorBrush x:Key="PrimaryFg" Color="#0B0E11"/>
  <SolidColorBrush x:Key="PrimaryMuted" Color="#3A3A1F"/>
  <SolidColorBrush x:Key="PrimaryTint" Color="#1AFCD535"/>
  <SolidColorBrush x:Key="Warning" Color="#F0B90B"/>
  <SolidColorBrush x:Key="Info" Color="#2DBDB6"/>
  <SolidColorBrush x:Key="Overlay" Color="#80000000"/>
  <!-- 떠 있는 층(확인창)에만 쓰는 그림자 색 (§4.5 shadow-modal) -->
  <Color x:Key="ShadowColor">#000000</Color>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <!-- 글꼴: §3.1. exe에 내장(Fonts/). Plex에 한글이 없어 글자 단위로 Noto Sans KR(KS X 1001 2350자) →
       그래도 없는 희귀 글자는 맑은 고딕으로 넘어간다 -->
  <FontFamily x:Key="FontSans">./Fonts/#IBM Plex Sans, ./Fonts/#Noto Sans KR, Segoe UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- 키보드 포커스: 2px 노랑 외곽선, 2px 간격 (§9) -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2" BorderBrush="{StaticResource Primary}" BorderThickness="2" CornerRadius="4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 아이콘 글리프 (Segoe Fluent Icons 코드포인트) -->
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- 텍스트 위계 (§3.2) -->
  <Style x:Key="T.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="T.Panel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="T.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="T.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
  </Style>

  <!-- 버튼 공통 (§5.1): 반경 4px, 굵기 500, 배경색 전환만 -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource Primary}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryFg}"/>
    <Style.Triggers>
      <!-- 노랑은 hover·press 모두 어두워지기만 한다 -->
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource PrimaryMuted}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource BgElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BorderStrong}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BgElevated}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 탭 (§5.3): 밑줄형만. 활성 = 기본 텍스트 + 2px 노랑 바 -->
  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="0,0,24,0">
            <ContentPresenter Margin="0,10" VerticalAlignment="Center"/>
            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Primary}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 켜기/끄기 스위치: 행마다 반복되므로 노랑 대신 회색 단계로 상태 표현.
       꺼짐은 외곽선형 — 채움형이면 hover된 행(BgElevated)과 색이 같아 트랙이 사라진다 -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="Transparent"
                  BorderBrush="{StaticResource TextTertiary}" BorderThickness="1">
            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource TextTertiary}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource TextSecondary}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBase}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 다중 선택 체크박스: 여러 줄에 반복되므로 노랑 대신 밝은 회색 채움 -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1"
                    BorderBrush="{StaticResource TextTertiary}" Background="Transparent" VerticalAlignment="Center">
              <TextBlock x:Name="Mark" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                         Foreground="{StaticResource BgBase}" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource TextPrimary}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 입력칸 (§5.2) -->
  <Style TargetType="TextBox">
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="12,0">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 진행 막대: 작업 중엔 주 버튼이 사라지므로 노랑을 대신 쓴다 -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Background" Value="{StaticResource BgElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- 얇은 스크롤바 6px (§12 global base) -->
  <Style x:Key="ThinThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="T" CornerRadius="3" Background="{StaticResource BgElevated}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="Background" Value="{StaticResource BorderStrong}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/>
    <Setter Property="MinWidth" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource ThinThumb}"/>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 목록 행 (§5.4): 구분선·줄무늬 없음, hover만 한 단계 밝게 -->
  <Style x:Key="Row" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="16,0" MinHeight="56">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevated}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource Row}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <!-- 기본 템플릿은 비활성(작업 중)일 때 배경을 시스템 흰색으로 바꾼다 → 테두리 없는 단순 템플릿으로 교체 -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
